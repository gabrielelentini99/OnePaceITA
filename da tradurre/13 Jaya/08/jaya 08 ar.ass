Comment: 0,0:00:00.00,0:00:00.00,AR-Main,,0,0,0,,{=47}===============================DIALOGUE============================
Dialogue: 0,0:01:54.76,0:01:59.43,AR-Main,,0,0,0,,{\be3}!ماذا يفعل؟! لقد حلّ الصباح
Dialogue: 0,0:01:59.43,0:02:04.48,AR-Main,,0,0,0,,{\be3}!تجاوزنا الموعد المحدّد بأكثر من 46 دقيقة! سيفوتنا التّيّار
Dialogue: 0,0:02:04.48,0:02:08.73,AR-Main,,0,0,0,,{\be3}!سيحتاج وقتًا أطول للعودة لأنّه يحمل كلّ ذلك الذّهب الآن
Dialogue: 0,0:02:08.73,0:02:11.86,AR-Main,,0,0,0,,{\be3}!أنا واثقة أنّه لم يأخذ ذلك في حسبانه
Dialogue: 0,0:02:11.86,0:02:15.24,AR-Main,,0,0,0,,{\be3}لا، لا أعتقد أنّه أخذ الوقت في الحسبان منذ البداية
Dialogue: 0,0:02:15.24,0:02:16.70,AR-Main,,0,0,0,,{\be3}%نعم، متأكّد من ذلك 100
Dialogue: 0,0:02:16.70,0:02:19.45,AR-Main,,0,0,0,,{\be3}هل تعتقدون أنّه هُزم في البلدة؟
Dialogue: 0,0:02:19.83,0:02:21.50,AR-Main,,0,0,0,,{\be3}!على يد بيلامي ذاك؟
Dialogue: 0,0:02:21.50,0:02:24.42,AR-Main,,0,0,0,,{\be3}!إن هُزم، فسيدفع ثمنًا باهظًا حتّى إن عاد في الوقت المناسب
Dialogue: 0,0:02:24.92,0:02:26.92,AR-Main,,0,0,0,,{\be3}ما مشكلتكِ؟
Dialogue: 0,0:02:30.67,0:02:33.68,AR-Main,,0,0,0,,{\be3}!مرحبًا
Dialogue: 0,0:02:37.64,0:02:40.47,AR-Main,,0,0,0,,{\be3}!هذا هو! هذا جيّد! لقد عاد
Dialogue: 0,0:02:40.47,0:02:42.35,AR-Main,,0,0,0,,{\be3}!وجدتها
Dialogue: 0,0:02:42.35,0:02:45.73,AR-Main,,0,0,0,,{\be3}!لوفي! أسرع! لقد تأخّرنا
Dialogue: 0,0:02:45.73,0:02:47.27,AR-Main,,0,0,0,,{\be3}!انظروا لهذه
Dialogue: 0,0:02:47.27,0:02:51.32,AR-Main,,0,0,0,,{\be3}!خنفساء هرقل! أخذ بحثي عنها وقتًا طويلًا
Dialogue: 0,0:02:51.32,0:02:52.69,AR-Main,,0,0,0,,{\be3}...كنتَ تبحث
Dialogue: 0,0:02:52.69,0:02:54.07,AR-Main,,0,0,0,,{\be3}!عن خنفساء؟...
Dialogue: 0,0:03:02.66,0:03:05.04,AR-Main,,0,0,0,,{\be3}!ماذا؟! مذهل
Dialogue: 0,0:03:05.04,0:03:07.83,AR-Main,,0,0,0,,{\be3}!إنّه النّموذج الطّائر لغوينغ ميري
Dialogue: 0,0:03:07.83,0:03:09.71,AR-Main,,0,0,0,,{\be3}!يبدو أنّها قادرة على الطّيران
Dialogue: 0,0:03:09.71,0:03:13.01,AR-Main,,0,0,0,,{\be3}!أليس كذلك؟! فعلوا ذلك من أجلنا
Dialogue: 0,0:03:17.72,0:03:18.72,AR-Main,,0,0,0,,{\be3}...انظروا إليهم
Dialogue: 0,0:03:18.72,0:03:21.47,AR-Main,,0,0,0,,{\be3}...بمجرد أن أنظر إليهم أشعر بعدم الرّاحة
Dialogue: 0,0:03:21.47,0:03:22.60,AR-Main,,0,0,0,,{\be3}...حسنٌ، هذا صحيح
Dialogue: 0,0:03:23.22,0:03:26.94,AR-Main,,0,0,0,,{\be3}حتّى الحمامة كانت لتبدو أفضل من الدّجاجة
Dialogue: 0,0:03:26.94,0:03:29.73,AR-Main,,0,0,0,,{\be3}!تلك ليست المشكلة هنا يا أحمق
Dialogue: 0,0:03:29.73,0:03:33.40,AR-Main,,0,0,0,,{\be3}!حسنًا! لنبحر! أمستعدّون يا رجال؟
Dialogue: 0,0:03:33.40,0:03:34.74,AR-Main,,0,0,0,,{\be3}!نعم، نعم يا سيّدي
Dialogue: 0,0:03:40.45,0:03:42.95,AR-Main,,0,0,0,,{\be3}!اصعدوا للسّفينة بسرعة! الوقت يداهمكم
Dialogue: 0,0:03:42.95,0:03:47.04,AR-Main,,0,0,0,,{\be3}أتنوون إضاعة فرصتكم بالمضي للسّماء أيّها الحمقى؟
Dialogue: 0,0:03:47.46,0:03:49.46,AR-Main,,0,0,0,,{\be3}!صحيح! شكرًا على إصلاح السفينة
Dialogue: 0,0:03:53.09,0:03:55.55,AR-Main,,0,0,0,,{\be3}.هم من يستحقون الشكر
Dialogue: 0,0:03:56.26,0:03:58.72,AR-Main,,0,0,0,,{\be3}!نعم، شكرًا يا رفاق
Dialogue: 0,0:03:58.72,0:04:01.22,AR-Main,,0,0,0,,{\be3}!بإمكانكم الاحتفاظ بخنفساء هرقل خاصّتي
Dialogue: 0,0:04:01.64,0:04:05.73,AR-Main,,0,0,0,,{\be3}!فعلًا؟! هل أنت جادّ؟! يمكننا ذلك؟
Dialogue: 0,0:04:05.73,0:04:08.10,AR-Main,,0,0,0,,{\be3}!أنت طيّب
Dialogue: 0,0:04:08.10,0:04:11.31,AR-Main,,0,0,0,,{\be3\q2}!على أيّ حال علينا الإسراع، اصعدوا على السفينة قبل فوات الأوان
Dialogue: 0,0:04:11.31,0:04:14.19,AR-Main,,0,0,0,,{\be3}!سنسبقكم وأنتم ستتبعوننا
Dialogue: 0,0:04:14.57,0:04:16.07,AR-Main,,0,0,0,,{\be3}!أسرِع يا لوفي
Dialogue: 0,0:04:16.07,0:04:17.45,AR-Main,,0,0,0,,{\be3}!حسنًا
Dialogue: 0,0:04:23.66,0:04:28.12,AR-Flashback,,0,0,0,,{\be3}مدينة الذهب مجرد ضرب خيال من نولاند
Dialogue: 0,0:04:29.75,0:04:31.50,AR-Main,,0,0,0,,{\be3}!يا تحالف ساروياما
Dialogue: 0,0:04:34.75,0:04:36.46,AR-Main,,0,0,0,,{\be3}!الإخفاق ليس خيارًا الآن
Dialogue: 0,0:04:36.96,0:04:41.72,AR-Main,,0,0,0,,{\be3}!ادعموهم بكلّ قوّتكم مهما حدث
Dialogue: 0,0:04:41.72,0:04:43.89,AR-Main,,0,0,0,,{\be3}!أجل
Dialogue: 0,0:04:46.39,0:04:47.89,AR-Main,,0,0,0,,{\be3}!حسنٌ! لننطلق
Dialogue: 0,0:04:51.77,0:04:53.44,AR-Main,,0,0,0,,{\be3}!حان وقت الإبحار يا رفاق
Dialogue: 0,0:04:53.44,0:04:54.40,AR-Main,,0,0,0,,{\be3}!أجل
Dialogue: 0,0:04:54.40,0:04:56.23,AR-Main,,0,0,0,,{\be3}!حاضر يا نامي-سان
Dialogue: 0,0:05:08.41,0:05:11.92,AR-Main,,0,0,0,,{\be3}!أيّها الفتى! هنا ستفترق طرقنا
Dialogue: 0,0:05:12.92,0:05:13.96,AR-Main,,0,0,0,,{\be3}!نعم
Dialogue: 0,0:05:14.71,0:05:18.92,AR-Main,,0,0,0,,{\be3}،هنالك حقيقة مؤكّدة واحدة
Comment: 0,0:05:18.30,0:05:18.92,Secondary-207-,,0,0,0,,{\be3}Huh?
Dialogue: 0,0:05:19.55,0:05:25.89,AR-Main,,0,0,0,,{\be3}!لم يسبق لأحدٍ إثبات عدم وجود مدينة الذهب ولا جزيرة السماء
Dialogue: 0,0:05:25.89,0:05:26.89,AR-Main,,0,0,0,,{\be3}!نعم
Dialogue: 0,0:05:28.18,0:05:33.94,AR-Main,,0,0,0,,{\be3\q2}!ربّما يضحك النّاس ويصفون الأمر بمنطق أحمق، لكنّ ذلك كافٍ بالنّسبة لي
Dialogue: 0,0:05:33.94,0:05:36.61,AR-Main,,0,0,0,,{\be3}!لكنّ ذلك هو ما تعنيه الرّومانسيّة
Dialogue: 0,0:05:36.61,0:05:38.07,AR-Main,,0,0,0,,{\be3}...الرّومانسيّة
Dialogue: 0,0:05:40.44,0:05:41.70,AR-Main,,0,0,0,,{\be3}!هذا صحيح
Dialogue: 0,0:05:45.70,0:05:48.83,AR-Main,,0,0,0,,{\be3}.شكرًا على الذّهب
Dialogue: 0,0:05:50.20,0:05:53.54,AR-Main,,0,0,0,,{\be3}!إيّاكم أن تسقطوا من السماء، مفهوم؟
Dialogue: 0,0:05:56.00,0:05:57.92,AR-Main,,0,0,0,,{\be3}!إلى اللّقاء أيّها العمّ
Dialogue: 0,0:05:57.92,0:06:00.46,AR-Main,,0,0,0,,{\be3}!شكرًا على كلّ شيء يا كريكت-سان
Dialogue: 0,0:06:00.46,0:06:05.26,AR-Main,,0,0,0,,{\be3}!أنا واثق أنّ مدينة الذّهب حقيقيّة أيّها العجوز
Dialogue: 0,0:06:05.26,0:06:08.43,AR-Main,,0,0,0,,{\be3}!أيّها العمّ! لا تحمّل نفسك
Dialogue: 0,0:06:08.43,0:06:10.73,AR-Main,,0,0,0,,{\be3}!اهتمّ بشؤونك الخاصّة
Dialogue: 0,0:06:18.19,0:06:20.40,AR-Main,,0,0,0,,{\be3}!حلّ الصّباح فعلًا
Dialogue: 0,0:06:20.82,0:06:23.20,AR-Main,,0,0,0,,{\be3}حسنًا، هل ترون أيّ شيء؟
Dialogue: 0,0:06:23.70,0:06:26.57,AR-Main,,0,0,0,,{\be3}!لا أستطيع حتّى رؤية أفق الشّاطئ المقابل لنا بعد
Dialogue: 0,0:06:26.57,0:06:29.66,AR-Main,,0,0,0,,{\be3}هل هم ذاهبون لجزيرة السماء حقًّا؟
Dialogue: 0,0:06:30.16,0:06:32.00,AR-Main,,0,0,0,,{\be3}نعم، ذلك ما قالوه
Dialogue: 0,0:06:32.00,0:06:36.46,AR-Main,,0,0,0,,{\be3}سيكون اللحاق بهم صعبًا، لذلك علينا الاهتمام بأمرهم قبل ذلك
Dialogue: 0,0:06:37.08,0:06:40.50,AR-Main,,0,0,0,,{\be3}!اسمعوا! إنّها السابعة صباحًا
Dialogue: 0,0:06:40.50,0:06:45.05,AR-Main,,0,0,0,,{\be3}!يجدر بنا أن نصل لوجهتنا حوالي الحادية عشر
Dialogue: 0,0:06:45.05,0:06:49.51,AR-Main,,0,0,0,,{\be3\q2}...كما قال العجوز، إنّ المكان الّذي ينطلق منه التيار البحري الصاعد
Dialogue: 0,0:06:49.51,0:06:56.52,AR-Main,,0,0,0,,{\be3}!يتغيّر في كلّ مرّة، لذلك علينا الوصول قبل ذلك وإيجاده...
Dialogue: 0,0:06:57.02,0:06:58.77,AR-Main,,0,0,0,,{\be3}!انظرا! انظرا
Dialogue: 0,0:06:58.77,0:07:01.98,AR-Main,,0,0,0,,{\be3}...نحن متأخّرون قليلًا، لذلك
Dialogue: 0,0:07:01.98,0:07:05.61,AR-Main,,0,0,0,,{\be3}!أنتم! هل تستمعون إلى شرحي؟
Dialogue: 0,0:07:05.61,0:07:07.82,AR-Main,,0,0,0,,{\be3}!أرأيتما؟ لقد نظر للأمام
Dialogue: 0,0:07:08.99,0:07:12.20,AR-Main,,0,0,0,,{\be3}!هنالك طيور غريبة حقًّا في هذا العالم
Dialogue: 0,0:07:12.20,0:07:17.33,AR-Main,,0,0,0,,{\be3}!صحيح! بإمكانه النّظر للجنوب فقط! إنّه أشبه ببوصلة! هذا ممتع
Dialogue: 0,0:07:21.59,0:07:22.67,AR-Main,,0,0,0,,{\be3}ما الّذي قاله؟
Dialogue: 0,0:07:23.17,0:07:26.59,AR-Main,,0,0,0,,{\be3}قال أنّه سينظر لاتّجاه مختلف لإرباكنا
Dialogue: 0,0:07:28.26,0:07:29.64,AR-Main,,0,0,0,,{\be3}!لماذا لا تحاول؟
Dialogue: 0,0:07:32.60,0:07:34.98,AR-Main,,0,0,0,,{\be3}!مهلًا! إنّه ينظر للشّمال
Dialogue: 0,0:07:43.07,0:07:45.36,AR-Main,,0,0,0,,{\be3}!لا يشعر بارتياح إلاّ إن نظر إلى الجنوب
Dialogue: 0,0:07:45.36,0:07:50.53,AR-Main,,0,0,0,,{\be3}!أنتم! لا تغضبوا الزّعيم العظيم
Dialogue: 0,0:07:51.28,0:07:57.00,AR-Main,,0,0,0,,{\be3}!لا بأس! إنّ عفويّتهم تُحمّسني
Dialogue: 0,0:07:57.33,0:07:58.96,AR-Main,,0,0,0,,{\be3}!ماذا؟ ماذا هنالك؟
Dialogue: 0,0:08:00.13,0:08:03.25,AR-Main,,0,0,0,,{\be3}!لا داعي لأن تقلقوا
Dialogue: 0,0:08:03.96,0:08:05.67,AR-Main,,0,0,0,,{\be3}لنستمتع بوقتنا
Dialogue: 0,0:08:05.67,0:08:07.93,AR-Main,,0,0,0,,{\be3}من تسبّ بتأخرنا؟
Dialogue: 0,0:08:08.43,0:08:13.51,AR-Main,,0,0,0,,{\be3}!إنّه محقّ! لا فائدة من الشّعور بالتّوتّر طوال هذه الساعات
Dialogue: 0,0:08:13.51,0:08:18.52,AR-Main,,0,0,0,,{\be3}!فهمت! حسنٌ يا رجال! انطلقوا بأقصى سرعة وبارتياح
Dialogue: 0,0:08:21.36,0:08:23.90,AR-Main,,0,0,0,,{\be3}~يا له من طقس جميل
Dialogue: 0,0:08:27.03,0:08:28.49,AR-Main,,0,0,0,,{\be3}!هل سنكون بخير؟
Dialogue: 0,0:08:28.90,0:08:31.70,AR-Main,,0,0,0,,{\be3}!أخبار سيّئة يا زعيم
Dialogue: 0,0:08:30.79,0:08:31.70,AR-Secondary,,0,0,0,,{\be3}!ما الخطب؟
Dialogue: 0,0:08:31.70,0:08:35.16,AR-Main,,0,0,0,,{\be3}!يحلّ اللّيل في الجنوب الغربيّ! إنّها السحب الملكيّة
Dialogue: 0,0:08:35.16,0:08:37.58,AR-Main,,0,0,0,,{\be3}!فعلًا؟! ما الوقت الآن؟
Dialogue: 0,0:08:37.58,0:08:40.75,AR-Main,,0,0,0,,{\be3}!إنّها العاشرة! هذا أبكر بكثير مما توقّعنا
Dialogue: 0,0:08:40.75,0:08:43.13,AR-Main,,0,0,0,,{\be3}!هذا سيّئ يا شوجو! أيمكننا الوصول في الوقت؟
Dialogue: 0,0:08:43.13,0:08:47.17,AR-Main,,0,0,0,,{\be3}!إلى البحر في الحال يا غطّاسي أوتان! ابحثوا عن التّيّار
Dialogue: 0,0:08:50.30,0:08:51.39,AR-Main,,0,0,0,,{\be3\clip(781.2,948,1051.46,1054.19)}!تلك هي... السحب الملكيّة
Dialogue: 0,0:08:51.37,0:08:52.01,AR-Main,,0,0,0,,{\be3}!تلك هي... السحب الملكيّة
Dialogue: 0,0:08:52.80,0:08:54.39,AR-Main,,0,0,0,,{\be3}ما الخطب؟
Dialogue: 0,0:08:55.51,0:09:00.60,AR-Main,,0,0,0,,{\be3\q2}ظهرت السحب الملكية أبكر ممّا توقّعنا لكنّنا لم نعرف حتّى مكان التّيّار
Dialogue: 0,0:09:08.32,0:09:12.70,AR-Main,,0,0,0,,{\be3}!كُشِفت تردّدات صوتيّة! ثمّة تيّار ضخم أمامنا مباشرةً
Dialogue: 0,0:09:12.70,0:09:16.66,AR-Main,,0,0,0,,{\be3}!مخلوقات ضخمة غربنا مباشرةً! يبدو أنّها ملوك بحر
Dialogue: 0,0:09:17.37,0:09:20.62,AR-Main,,0,0,0,,{\be3}!ثمّة موجات عكس التّيّار في اتّجاه الساعة العاشرة
Dialogue: 0,0:09:20.62,0:09:22.67,AR-Main,,0,0,0,,{\be3}!أعتقد أنّها دوّامة ضخمة
Dialogue: 0,0:09:22.67,0:09:26.13,AR-Main,,0,0,0,,{\be3}!هذا هو! اسلكوا اتّجاه الساعة العاشرة
Dialogue: 0,0:09:26.13,0:09:29.92,AR-Main,,0,0,0,,{\be3}!إنّها إشارة على الانفجار! اتّجهوا نحو الدّوّامة ولا تتراجعوا
Dialogue: 0,0:09:34.72,0:09:35.85,AR-Main,,0,0,0,,{\be3}!ما الّذي...؟
Dialogue: 0,0:09:35.85,0:09:39.10,AR-Main,,0,0,0,,{\be3}!أصبحت الأمواج أعلى فجأة
Dialogue: 0,0:09:37.54,0:09:39.10,AR-Secondary,,0,0,0,,{\be3}!سوف نغرق
Dialogue: 0,0:09:41.06,0:09:43.94,AR-Main,,0,0,0,,{\be3}!إنّه زلزال يسبق الانفجار! استعدّوا
Dialogue: 0,0:09:43.94,0:09:45.56,AR-Main,,0,0,0,,{\be3}!ا-انفجار؟
Dialogue: 0,0:09:46.07,0:09:47.02,AR-Main,,0,0,0,,{\be3}!أيّتها الملاّحة
Dialogue: 0,0:09:47.69,0:09:49.24,AR-Main,,0,0,0,,{\be3}إلامَ تشير البوصلة المسجِّلة؟
Dialogue: 0,0:09:52.07,0:09:53.84,AR-Main,,0,0,0,,{\be3}!إنّها تشير لتلك السحب
Dialogue: 0,0:09:54.84,0:09:57.49,AR-Main,,0,0,0,,{\be3}!هل جزيرة السماء هناك؟
Dialogue: 0,0:09:58.20,0:09:59.79,AR-Main,,0,0,0,,{\be3}!اتّجاه الرّياح مثاليّ أيضًا
Dialogue: 0,0:09:59.79,0:10:02.50,AR-Main,,0,0,0,,{\be3}!إنّ السحب متّجهة مباشرة إلى مركز الدّوّامة
Dialogue: 0,0:10:02.50,0:10:05.92,AR-Main,,0,0,0,,{\be3}...ماذا تقصدين بـ«الدوامة»؟ أنا لا أرى شيئًا
Dialogue: 0,0:10:06.59,0:10:09.76,AR-Main,,0,0,0,,{\be3}!يبدو أنّنا أصبنا الهدف هذه المرّة يا أخي
Dialogue: 0,0:10:09.76,0:10:13.18,AR-Main,,0,0,0,,{\be3}!نعم! ويبدو أنّه سيكون انفجارًا ذا حجم جيّد أيضًا
Dialogue: 0,0:10:13.18,0:10:14.55,AR-Main,,0,0,0,,{\be3}!بإمكاننا الذّهاب؟
Dialogue: 0,0:10:14.55,0:10:15.97,AR-Main,,0,0,0,,{\be3}!نعم، بإمكانكم
Dialogue: 0,0:10:18.06,0:10:18.85,AR-Main,,0,0,0,,{\be3}ماذا؟
Dialogue: 0,0:10:18.85,0:10:21.14,AR-Main,,0,0,0,,{\be3}!سنأخذكم إلى الحافّة الدّاخليّة للدّوّامة
Dialogue: 0,0:10:21.64,0:10:23.56,AR-Main,,0,0,0,,{\be3}!ماذا نفعل بعد ذلك؟
Dialogue: 0,0:10:23.56,0:10:27.94,AR-Main,,0,0,0,,{\be3}!اركبوا التّيّار! إن وصلتم إلى المركز، فستسير الأمور كما يجب
Dialogue: 0,0:10:29.40,0:10:31.40,AR-Main,,0,0,0,,{\be3}!مركز هذه الدّوّامة الضّخمة؟
Dialogue: 0,0:10:36.03,0:10:38.37,AR-Main,,0,0,0,,{\be3}!لم أسمع عن هذا قطّ
Dialogue: 0,0:10:38.78,0:10:41.87,AR-Main,,0,0,0,,{\be3}!لا بأس! سأحميك أنت وروبين-تشان
Dialogue: 0,0:10:42.58,0:10:44.54,AR-Main,,0,0,0,,{\be3}...لم أرَ دوّامة ضخمة كهذه من قبل
Dialogue: 0,0:10:47.42,0:10:50.88,AR-Main,,0,0,0,,{\be3}!مصيبة عظيمة! هذا سيّئ! لنعد أدراجنا! دعوني أعود
Dialogue: 0,0:10:50.88,0:10:54.18,AR-Main,,0,0,0,,{\be3\q2}!تقبّل الأمر فحسب يا أوسوبّ! فات الأوان! فهنالك من هو متحمّس سلفًا
Dialogue: 0,0:10:54.59,0:10:56.68,AR-Main,,0,0,0,,{\be3}!لنذهب إلى جزيرة السماء
Dialogue: 0,0:11:19.33,0:11:24.96,AR-Main,,0,0,0,,{\be3}!حسنٌ يا رفاق! الباقي منوط بكم أنتم الآن
Dialogue: 0,0:11:24.96,0:11:28.08,AR-Main,,0,0,0,,{\be3}!حسنًا! شكرًا على مرافقتنا
Dialogue: 0,0:11:27.33,0:11:28.08,AR-Secondary,,0,0,0,,{\be3}!مهلًا
Dialogue: 0,0:11:28.58,0:11:32.34,AR-Main,,0,0,0,,{\be3}!على مهلكم! أنا خائف
Dialogue: 0,0:11:32.34,0:11:34.26,AR-Main,,0,0,0,,{\be3}!دعني أعود أيّها الوغد
Dialogue: 0,0:11:34.26,0:11:36.09,AR-Main,,0,0,0,,{\be3}!هذا الشّيء سيقتلنا في الحال
Dialogue: 0,0:11:36.09,0:11:39.51,AR-Main,,0,0,0,,{\be3}!لم يخبرنا أحد عن دوّامة عملاقة! لقد خدعتمونا
Dialogue: 0,0:11:39.51,0:11:41.06,AR-Main,,0,0,0,,{\be3}!حلّ اللّيل
Dialogue: 0,0:11:41.06,0:11:44.56,AR-Main,,0,0,0,,{\be3}!الدّوّامة تسحبنا إليها
Dialogue: 0,0:11:44.56,0:11:48.06,AR-Main,,0,0,0,,{\be3}!لنعد يا لوفي! ما زال بإمكاننا ذلك
Dialogue: 0,0:11:48.06,0:11:51.86,AR-Main,,0,0,0,,{\be3}!أليس الأمر واضحًا؟! هذه الدّوّامة وحدها كفيلة بقتلنا
Dialogue: 0,0:11:51.86,0:11:53.69,AR-Main,,0,0,0,,{\be3}!جزيرة السماء مجرّد حلم في حلم
Dialogue: 0,0:11:53.69,0:11:56.20,AR-Main,,0,0,0,,{\be3}حلم في حلم؟ أهذا ما تظنّ؟
Dialogue: 0,0:11:56.20,0:11:59.53,AR-Main,,0,0,0,,{\be3}!نعم يا لوفي! لا أعتقد أنّ بإمكاننا ذلك أيضًا
Dialogue: 0,0:11:59.91,0:12:01.91,AR-Main,,0,0,0,,{\be3}!جزيرة في حلم في حلم
Dialogue: 0,0:12:01.91,0:12:05.79,AR-Main,,0,0,0,,{\be3}!سأندم طوال حياتي إن فوّتّ مغامرة كبيرة كهذه
Dialogue: 0,0:12:06.50,0:12:09.42,AR-Main,,0,0,0,,{\be3}...يـ-يبدو مستمعًا
Dialogue: 0,0:12:13.42,0:12:16.22,AR-Main,,0,0,0,,{\be3}...بينما تعارضون الأمر بلا فائدة
Dialogue: 0,0:12:16.22,0:12:17.38,AR-Main,,0,0,0,,{\be3}ماذا هنالك؟
Dialogue: 0,0:12:20.84,0:12:22.64,AR-Main,,0,0,0,,{\be3}!تسحبنا الدّوّامة إلى داخلها
Dialogue: 0,0:12:25.06,0:12:28.73,AR-Main,,0,0,0,,{\be3}!بسرعة يا نامي-سان! تعالي لذراعيّ
Dialogue: 0,0:12:30.65,0:12:31.79,AR-Main,,0,0,0,,{\be3}!نحن نسقط
Dialogue: 0,0:12:36.36,0:12:38.82,AR-Main,,0,0,0,,{\be3}!ماذا؟! إنّها تختفي؟! لماذا؟
Dialogue: 0,0:12:38.82,0:12:39.91,AR-Main,,0,0,0,,{\be3}!ماذا حدث؟
Dialogue: 0,0:12:39.91,0:12:44.83,AR-Main,,0,0,0,,{\be3}!كـ-كانت تلك الدّوّامة ضخمة أيضًا! ما الّذي يحدث؟
Dialogue: 0,0:12:50.71,0:12:54.34,AR-Main,,0,0,0,,{\be3}!كلّا! بدأ الأمر سلفًا
Comment: 0,0:12:54.34,0:12:55.46,AR-Main,,0,0,0,,{\be3}Huh?
Dialogue: 0,0:12:56.13,0:12:58.80,AR-Main,,0,0,0,,{\be3}!اختفت الدّوّامة من السطح فحسب
Dialogue: 0,0:13:00.38,0:13:03.30,AR-Main,,0,0,0,,{\be3}...تـ-تقصدين
Dialogue: 0,0:13:03.30,0:13:05.81,AR-Main,,0,0,0,,{\be3}!مهلًا
Dialogue: 0,0:13:08.85,0:13:09.85,AR-Main,,0,0,0,,{\be3}!يا زورو
Dialogue: 0,0:13:10.48,0:13:11.35,AR-Main,,0,0,0,,{\be3}!انظر
Dialogue: 0,0:13:19.15,0:13:23.62,AR-Main,,0,0,0,,{\be3}!لحقت بك يا قبّعة القشّ لوفي
Dialogue: 0,0:13:24.20,0:13:26.20,AR-Main,,0,0,0,,{\be3}!إنّه ذلك الرّجل من موكتاون
Dialogue: 0,0:13:28.41,0:13:29.33,AR-Main,,0,0,0,,{\be3}!من؟
Dialogue: 0,0:13:29.33,0:13:34.29,AR-Main,,0,0,0,,{\be3}!أنا هنا للحصول على مكافأة المئة مليون الّتي على رأسك! استعدّ
Dialogue: 0,0:13:39.59,0:13:42.34,AR-Main,,0,0,0,,{\be3}من يكونون؟ أهم أصدقاءهم؟
Dialogue: 0,0:13:43.18,0:13:44.97,AR-Main,,0,0,0,,{\be3}حسنٌ، لا أعلم
Dialogue: 0,0:13:48.93,0:13:50.77,AR-Main,,0,0,0,,{\be3}لماذا حلّ الظّلام هنا؟
Dialogue: 0,0:13:50.77,0:13:53.90,AR-Main,,0,0,0,,{\be3}مكافأتي؟ ماذا تعني بمئة مليون؟
Dialogue: 0,0:13:53.90,0:13:56.27,AR-Main,,0,0,0,,{\be3}!إذًا فأنت لم تعرف
Dialogue: 0,0:13:56.90,0:14:01.65,AR-Main,,0,0,0,,{\be3}!هنالك مكافأة مئة مليون على رأسك
Dialogue: 0,0:14:01.65,0:14:05.95,AR-Main,,0,0,0,,{\be3}!وعلى رأسكَ يا صائد القراصنة زورو ستّون مليون بيري
Dialogue: 0,0:14:05.95,0:14:08.95,AR-Main,,0,0,0,,{\be3}!ذلك صحيح! لديه ملصقات مطلوبين جديدة
Dialogue: 0,0:14:08.95,0:14:12.08,AR-Main,,0,0,0,,{\be3}!يا زورو، بات لديكَ مكافأةٌ على رأسك
Dialogue: 0,0:14:12.08,0:14:16.29,AR-Main,,0,0,0,,{\be3}!ماذا؟! تمهّل! ماذا عنّي؟! هنالك واحدة لي أيضًا، صحيح؟
Dialogue: 0,0:14:16.29,0:14:17.88,AR-Main,,0,0,0,,{\be3}.كلا
Dialogue: 0,0:14:17.88,0:14:19.38,AR-Main,,0,0,0,,{\be3}!انظر جيّدًا
Dialogue: 0,0:14:20.01,0:14:20.84,AR-Main,,0,0,0,,{\be3}.كلا
Dialogue: 0,0:14:23.09,0:14:27.01,AR-Main,,0,0,0,,{\be3}!فهمت! ارتفعت مكافأتك كثيرًا بعد حادثة أرباستا
Dialogue: 0,0:14:27.01,0:14:28.68,AR-Main,,0,0,0,,{\be3}!...لكن مئة مليون
Dialogue: 0,0:14:30.27,0:14:34.40,AR-Main,,0,0,0,,{\be3}!مئة مليون! أسمعتَ ذلك؟! مكافأتي مئة مليون
Dialogue: 0,0:14:34.40,0:14:36.73,AR-Main,,0,0,0,,{\be3}!وأنا ستّون مليون فقط؟! هذا محبط
Dialogue: 0,0:14:36.73,0:14:38.69,AR-Main,,0,0,0,,{\be3}!لا تفرحا بهذا
Dialogue: 0,0:14:39.90,0:14:43.20,AR-Main,,0,0,0,,{\be3}!يا رفاق! لا تدعوهم يشتّتون انتباهكم
Dialogue: 0,0:14:47.07,0:14:51.16,AR-Main,,0,0,0,,{\be3}!إنّ التيار البحري الصاعد قادم
Dialogue: 0,0:14:51.70,0:14:54.12,AR-Main,,0,0,0,,{\be3}!استعدّوا
Dialogue: 0,0:14:56.58,0:14:57.46,AR-Main,,0,0,0,,{\be3}ما الّذي...؟
Dialogue: 0,0:14:58.04,0:15:01.00,AR-Main,,0,0,0,,{\be3}!تشبّثوا بالسفينة جميعًا! أو ادخلوا للدّاخل
Dialogue: 0,0:15:01.00,0:15:07.09,AR-Main,,0,0,0,,{\be3}!إن السفينة ترتفع
Dialogue: 0,0:15:44.34,0:15:47.43,AR-Main,,0,0,0,,{\be3}!مصيبة! ستنقلب سفينتنا
Dialogue: 0,0:15:49.89,0:15:51.85,AR-Main,,0,0,0,,{\be3}!تحمّلوا
Dialogue: 0,0:15:51.85,0:15:53.60,AR-Main,,0,0,0,,{\be3}!إيّاكم أن تُرموا من على السفينة
Dialogue: 0,0:15:57.27,0:16:00.44,AR-Main,,0,0,0,,{\be3}!اذهبوا... إلى جزيرة السماء
Dialogue: 0,0:16:02.40,0:16:03.86,AR-Main,,0,0,0,,{\be3}!ما الّذي يحدث؟
Dialogue: 0,0:16:03.86,0:16:07.32,AR-Main,,0,0,0,,{\be3}!إنّ السفينة تصعد عمودًا من الماء
Dialogue: 0,0:16:07.32,0:16:08.36,AR-Main,,0,0,0,,{\be3}!هذا ممتع
Dialogue: 0,0:16:08.36,0:16:10.37,AR-Main,,0,0,0,,{\be3}!كيف يحدث هذا؟
Dialogue: 0,0:16:12.37,0:16:13.33,AR-Main,,0,0,0,,{\be3}الرّياح؟
Dialogue: 0,0:16:13.91,0:16:20.33,AR-Main,,0,0,0,,{\be3}!حسنٌ، بإمكاننا الآن الذّهاب للسّماء! انطلقي يا ميري
Dialogue: 0,0:16:22.29,0:16:25.76,AR-Main,,0,0,0,,{\be3}!مهلًا! لا أعتقد أنّ الأمر سيكون سهلًا
Dialogue: 0,0:16:25.76,0:16:27.05,AR-Main,,0,0,0,,{\be3}!ما-ما الخطب؟
Dialogue: 0,0:16:27.05,0:16:29.22,AR-Main,,0,0,0,,{\be3}ماذا؟ هل نسينا أمرًا ما؟
Dialogue: 0,0:16:29.22,0:16:31.47,AR-Main,,0,0,0,,{\be3}!هيكل السفينة بدأ يطفوا
Comment: 0,0:16:31.47,0:16:32.55,AR-Main,,0,0,0,,{\be3}Huh?!
Dialogue: 0,0:16:32.55,0:16:35.56,AR-Main,,0,0,0,,{\be3}!إن استمرّ هذا، فسنحلّق بعيدًا نحو هلاكنا
Dialogue: 0,0:16:35.56,0:16:41.31,AR-Main,,0,0,0,,{\be3}!لكن ما الّذي تريدنا أن نفعله؟! بالكاد نستطيع التشبث
Dialogue: 0,0:16:41.31,0:16:43.27,AR-Main,,0,0,0,,{\be3}!ما ذلك؟
Dialogue: 0,0:16:44.32,0:16:45.40,AR-Main,,0,0,0,,{\be3}!ملك بحر
Dialogue: 0,0:16:45.40,0:16:47.61,AR-Main,,0,0,0,,{\be3}!إنّه الّذي سُحِبَ للدّوّامة قبل قليل
Dialogue: 0,0:16:51.91,0:16:55.54,AR-Main,,0,0,0,,{\be3}!أرأيتم؟! إنّها مسألة وقت فحسب قبل أن يحدث ذلك لنا
Dialogue: 0,0:16:55.54,0:17:01.04,AR-Main,,0,0,0,,{\be3}!مهلًا، حتى وإن قلت ذلك، فنحن نركب انفجارًا قويًّا
Dialogue: 0,0:17:01.04,0:17:02.50,AR-Main,,0,0,0,,{\be3}!فما الذي بإمكاننا فعله؟
Dialogue: 0,0:17:02.50,0:17:05.46,AR-Main,,0,0,0,,{\be3}!أعتقد أنّها مجرّد ظاهرة طبيعيّة
Dialogue: 0,0:17:07.84,0:17:09.80,AR-Main,,0,0,0,,{\be3}!تسقط علينا أشياء كثيرة
Dialogue: 0,0:17:10.34,0:17:13.47,AR-Main,,0,0,0,,{\be3}!إنها ضحايا التيار البحري الصاعد
Dialogue: 0,0:17:13.47,0:17:18.52,AR-Main,,0,0,0,,{\be3}!سنهلك، سنسقط وسنصطدم بالمحيط وسنموت
Comment: 0,0:17:20.98,0:17:22.81,AR-Main,,0,0,0,,{\be3}– Spread the sails! Right away!\N– Eh?
Dialogue: 0,0:17:20.98,0:17:22.81,AR-Main,,0,0,0,,{\be3}!افردوا الأشرعة في الحال
Dialogue: 0,0:17:23.48,0:17:27.94,AR-Main,,0,0,0,,{\be3}!هذا هو البحر! وليس مجرّد عمود ماء! إنّه تيّار صاعد
Dialogue: 0,0:17:27.94,0:17:30.24,AR-Main,,0,0,0,,{\be3}والرّياح الّتي تهبّ من تحت عبارة عن تيّار هوائيّ صاعد
Dialogue: 0,0:17:30.24,0:17:33.53,AR-Main,,0,0,0,,{\be3}!أنتجته الحرارة الجوفيّة وبخار الانفجار
Dialogue: 0,0:17:34.07,0:17:36.83,AR-Main,,0,0,0,,{\be3}!إن كنّا نتعامل مع رياح وبحر، فذلك اختصاصي
Dialogue: 0,0:17:37.20,0:17:39.25,AR-Main,,0,0,0,,{\be3}!من في رأيكم ملاّحة هذه السفينة؟
Dialogue: 0,0:17:41.04,0:17:43.25,AR-Main,,0,0,0,,{\be3}!أنتِ يا نامي-سان
Dialogue: 0,0:17:43.25,0:17:46.38,AR-Main,,0,0,0,,{\be3}!يا رفاق! افعلوا ما قالته نامي-سان
Dialogue: 0,0:17:46.38,0:17:47.71,AR-Main,,0,0,0,,{\be3}!أجل
Dialogue: 0,0:17:47.71,0:17:51.68,AR-Main,,0,0,0,,{\be3\q2}!اركبوا رياح الميمنة واسحبوا الدّفّة نحوها! صفّوا السفينة مع التّيّار
Dialogue: 0,0:17:51.68,0:17:52.38,AR-Main,,0,0,0,,{\be3}!حاضر
Dialogue: 0,0:17:54.39,0:17:57.35,AR-Main,,0,0,0,,{\be3}!كلّا، مصيبة! توشك السفينة على ترك المياه
Dialogue: 0,0:17:57.76,0:18:00.81,AR-Main,,0,0,0,,{\be3}!سنسقط! سنسقط يا نامي! افعلي شيئًا يا نامي
Dialogue: 0,0:18:00.81,0:18:02.77,AR-Main,,0,0,0,,{\be3}!لا، بإمكاننا النّجاح
Dialogue: 0,0:18:06.48,0:18:08.15,AR-Main,,0,0,0,,{\be3}!نحن نطير
Dialogue: 0,0:18:10.36,0:18:13.07,AR-Main,,0,0,0,,{\be3}!مذهل! السفينة تطير
Dialogue: 0,0:18:13.57,0:18:14.45,AR-Main,,0,0,0,,{\be3}!هذا حقيقيّ؟
Dialogue: 0,0:18:17.16,0:18:18.37,AR-Main,,0,0,0,,{\be3}!نجحنا
Dialogue: 0,0:18:18.37,0:18:19.79,AR-Main,,0,0,0,,{\be3}!أجل
Dialogue: 0,0:18:19.79,0:18:22.21,AR-Main,,0,0,0,,{\be3}!نامي-سان! أنتِ رائعة
Dialogue: 0,0:18:22.91,0:18:25.67,AR-Main,,0,0,0,,{\be3}!وأنا أحبّك
Dialogue: 0,0:18:26.29,0:18:30.59,AR-Thoughts,,0,0,0,,{\be3}!انطلقوا، نحو أقاصي السماء
Dialogue: 0,0:18:35.51,0:18:37.97,AR-Main,,0,0,0,,{\be3}!انطلقوا
Dialogue: 0,0:18:38.43,0:18:42.39,AR-Main,,0,0,0,,{\be3}!بهذه الرّياح وهذا التّيّار، بإمكاننا الانطلاق فوق بقدر ما نشاء
Dialogue: 0,0:18:42.98,0:18:46.15,AR-Main,,0,0,0,,{\be3}!يا نامي! هل نكاد نصل جزيرة السماء؟
Dialogue: 0,0:18:46.61,0:18:49.51,AR-Main,,0,0,0,,{\be3}!إن كان لها وجود، فستكون على الجانب الآخر من تلك السحب
Dialogue: 0,0:18:51.03,0:18:52.36,AR-Main,,0,0,0,,{\be3}!فوق السحب؟
Dialogue: 0,0:18:52.64,0:18:55.32,AR-Main,,0,0,0,,{\be3}!ما الّذي قد نجده هناك؟
Dialogue: 0,0:18:55.70,0:18:58.37,AR-Main,,0,0,0,,{\be3}!فلنخترق السحب الملكيّة
Comment: 0,0:00:00.00,0:00:00.00,AR-Main,,0,0,0,,{=48}===============================DIALOGUE============================
